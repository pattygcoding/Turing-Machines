begin
    text line, result;
    integer index;
    boolean carry;

    ! Read one line from standard input and drop its trailing blanks.
    infile in;
    in.open(blanks(80));
    in.inimage;
    line :- in.image;
    line.strip;

    ! Validate the tape.
    for index := 1 step 1 until line.length do
        if line.sub(index, 1) <> "0" and line.sub(index, 1) <> "1" then
        begin
            outtext("Invalid input: expected a binary string.");
            outimage;
            go to finished;
        end;

    ! The canonical machine: a binary incrementer.  Reading the tape from the
    ! right, every 1 becomes a 0 (carry); the first 0 becomes a 1 and the carry
    ! stops; if the carry runs off the tape a new leading 1 is added.
    result :- "";
    carry := true;
    index := line.length;
    while carry and index >= 1 do
    begin
        if line.sub(index, 1) = "1" then
        begin
            result :- "0" & result;
            index := index - 1;
        end
        else
        begin
            result :- "1" & result;
            carry := false;
            index := index - 1;
        end;
    end;
    if carry then
        result :- "1" & result
    else if index >= 1 then
        result :- line.sub(1, index) & result;

    outtext("Initial tape: "); outtext(line); outimage;
    outtext("Final tape: "); outtext(result); outimage;

finished:
end;
